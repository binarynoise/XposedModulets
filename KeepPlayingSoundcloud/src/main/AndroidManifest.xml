<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">
    
    <application android:label="Keep Playing, SoundCloud!">
        <meta-data
            android:name="xposedmodule"
            android:value="true"
            />
        <meta-data
            android:name="xposeddescription"
            android:value="Prevent SoundCloud from stopping playback when the app removed from the recent apps list."
            />
        <meta-data
            android:name="xposedminversion"
            android:value="93"
            />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/scope"
            />
    </application>

</manifest>
